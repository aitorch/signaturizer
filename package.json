{
  "name": "signaturizer",
  "version": "0.1.0",
  "description": "Desktop PDF signature application",
  "main": ".vite/build/main.js",
  "type": "module",
  "scripts": {
    "start": "electron-forge start",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "electron-forge make",
    "build:deb": "electron-forge make --targets @electron-forge/maker-deb"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.4.168",
    "svelte": "^5.0.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-deb": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "@electron-forge/plugin-vite": "^7.6.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/svelte": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "electron": "^33.4.11",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
