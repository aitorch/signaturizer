{
  "name": "signaturizer",
  "version": "0.1.0",
  "description": "Desktop PDF app for capturing handwritten signatures and stamping them onto documents",
  "main": ".vite/build/main.js",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "electron",
    "pdf",
    "signature",
    "svelte",
    "desktop"
  ],
  "scripts": {
    "start": "electron-forge start",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "electron-forge make",
    "build:deb": "electron-forge make --targets @electron-forge/maker-deb"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.4.168",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-deb": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "@electron-forge/plugin-vite": "^7.6.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/svelte": "^5.4.2",
    "autoprefixer": "^10.5.4",
    "electron": "^39.8.10",
    "jsdom": "^25.0.0",
    "postcss": "^8.5.25",
    "svelte": "^5.56.8",
    "tailwindcss": "^3.4.16",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
